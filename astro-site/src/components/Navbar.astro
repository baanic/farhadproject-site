---
const menuItems = [
  { label: "خانه", href: "/" },
  { label: "پروژه‌ها", href: "/portfolio" },
  { label: "خدمات", href: "/services" },
  { label: "درباره من", href: "/about" },
  { label: "تماس", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header style="
  background: #1B2A4A;
  padding: 16px 24px;
  border-bottom: 3px solid #B8763E;
  position: relative;
">
  <nav style="
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
  ">
    <!-- لوگو -->
    <a href="/" style="
      color: #F5F0E6;
      font-size: 20px;
      font-weight: 700;
      z-index: 10;
    ">
      فرهاد
    </a>

    <!-- دکمه همبرگری (فقط در موبایل) -->
    <button
      id="menu-toggle"
      aria-label="منو"
      style="
        display: none;
        background: none;
        border: none;
        cursor: pointer;
        padding: 8px;
        z-index: 10;
      "
    >
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#F5F0E6" stroke-width="2" stroke-linecap="round">
        <line x1="3" y1="6" x2="21" y2="6"></line>
        <line x1="3" y1="12" x2="21" y2="12"></line>
        <line x1="3" y1="18" x2="21" y2="18"></line>
      </svg>
    </button>

    <!-- منوی دسکتاپ -->
    <ul
      id="desktop-menu"
      style="
        list-style: none;
        display: flex;
        gap: 24px;
        margin: 0;
        padding: 0;
      "
    >
      {menuItems.map((item) => (
        <li>
          <a
            href={item.href}
            style={`
              color: ${currentPath === item.href ? "#B8763E" : "#F5F0E6"};
              font-size: 15px;
              padding: 8px 0;
              border-bottom: 2px solid ${currentPath === item.href ? "#B8763E" : "transparent"};
              transition: all 0.2s;
            `}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <!-- منوی موبایل (کشویی) -->
    <ul
      id="mobile-menu"
      style="
        display: none;
        position: absolute;
        top: 100%;
        right: 0;
        left: 0;
        background: #1B2A4A;
        list-style: none;
        margin: 0;
        padding: 16px 24px 24px;
        flex-direction: column;
        gap: 8px;
        border-bottom: 3px solid #B8763E;
      "
    >
      {menuItems.map((item) => (
        <li>
          <a
            href={item.href}
            style={`
              display: block;
              color: ${currentPath === item.href ? "#B8763E" : "#F5F0E6"};
              font-size: 16px;
              padding: 12px 0;
              border-bottom: 1px solid rgba(245, 240, 230, 0.1);
            `}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script is:inline>
  // مدیریت منوی موبایل
  (function () {
    const toggle = document.getElementById("menu-toggle");
    const mobileMenu = document.getElementById("mobile-menu");
    const desktopMenu = document.getElementById("desktop-menu");

    if (!toggle || !mobileMenu) return;

    // مدیریت اندازه صفحه
    function updateLayout() {
      if (window.innerWidth <= 768) {
        toggle.style.display = "block";
        desktopMenu.style.display = "none";
      } else {
        toggle.style.display = "none";
        desktopMenu.style.display = "flex";
        mobileMenu.style.display = "none";
      }
    }

    // باز و بسته کردن منو
    toggle.addEventListener("click", function () {
      const isOpen = mobileMenu.style.display === "flex";
      mobileMenu.style.display = isOpen ? "none" : "flex";
    });

    // بستن منو وقتی کاربر روی یک لینک کلیک می‌کند
    mobileMenu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", function () {
        mobileMenu.style.display = "none";
      });
    });

    // وقتی اندازه صفحه تغییر کرد
    window.addEventListener("resize", updateLayout);

    // اجرای اولیه
    updateLayout();
  })();
</script>