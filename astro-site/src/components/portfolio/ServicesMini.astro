---
const services = [
  {
    title: "دفتر فنی و مستندسازی",
    description: "مدیریت مستندات پروژه، شامل نقشه‌ها، RFIها، صورت‌جلسات و مکاتبات. تولید نقشه‌های As-built و هماهنگی بین‌رشته‌ای.",
    color: "#5C7A5C",
  },
  {
    title: "کنترل پروژه",
    description: "تهیه WBS سلسله‌مراتبی، تدوین برنامه زمان‌بندی MPP، بروزرسانی دوره‌ای و تحلیل تأخیرات.",
    color: "#2D5C8A",
  },
  {
    title: "متره، برآورد و صورت‌وضعیت",
    description: "متره تفصیلی و ریزمتره بر اساس فهرست‌بهای واحد پایه، تهیه صورت‌وضعیت‌های دوره‌ای و کنترل احجام.",
    color: "#D89B5A",
  },
  {
    title: "طراحی و اجرای آکوستیک",
    description: "طراحی لایه‌بندی آکوستیک استودیو، اتاق کنترل، اتاق ادیت و بازشنوایی. طراحی درب آکوستیک و پنجره ویزور.",
    color: "#5A4A7A",
  },
];
---

<section style="
  background: #F5F0E6;
  padding: 80px 24px;
">
  <div style="max-width: 1100px; margin: 0 auto;">
    <p style="
      color: #B8763E;
      font-size: 14px;
      letter-spacing: 3px;
      margin-bottom: 16px;
      text-align: center;
    ">
      SERVICES
    </p>

    <h2 style="
      color: #1B2A4A;
      font-size: 36px;
      margin-bottom: 48px;
      text-align: center;
    ">
      خدمات تخصصی
    </h2>

    <div style="
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    " class="services-grid">
      {services.map((service) => (
        <div style="
          background: #FFFFFF;
          border-radius: 12px;
          padding: 32px;
          border-top: 4px solid var(--service-color);
        " class="service-card">
          <div style={`
            --service-color: ${service.color};
            width: 48px;
            height: 48px;
            border-radius: 8px;
            background: ${service.color};
            opacity: 0.15;
            margin-bottom: 20px;
          `}></div>

          <h3 style="
            color: #1B2A4A;
            font-size: 20px;
            margin-bottom: 12px;
          ">
            {service.title}
          </h3>

          <p style="
            color: #4A5568;
            font-size: 15px;
            line-height: 1.9;
            margin: 0;
          ">
            {service.description}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .services-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>