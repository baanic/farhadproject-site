---
const gallery = [
  {
    image: "/images/portfolio/acoustic-01.png",
    title: "نصب لوله‌های برق",
    description: "در حال نصب و جاگذاری لوله‌های برق پس از اجرای بخش سازه‌ای",
  },
  {
    image: "/images/portfolio/acoustic-02.png",
    title: "اجرای تایل آکوستیک سقف",
    description: "اجرای لایه‌های آکوستیک سقف با دقت ترازیابی",
  },
  {
    image: "/images/portfolio/acoustic-03.jpg",
    title: "پیاده‌سازی محل متعلقات",
    description: "پیاده‌سازی دقیق محل متعلقات سقفی استودیوها با لیزر",
  },
  {
    image: "/images/portfolio/acoustic-04.png",
    title: "درب‌های آکوستیک",
    description: "نصب درب‌های تمام آکوستیک با نوار درزگیر و پاشنه فنی",
  },
  {
    image: "/images/portfolio/acoustic-05.jpg",
    title: "سقف پس از نصب وول‌پنل",
    description: "سقف پس از نصب وول‌پنل نورس‌پنل، قبل از دکور نهایی",
  },
  {
    image: "/images/portfolio/acoustic-06.png",
    title: "سطح تمام‌شده استودیو",
    description: "سطح نهایی استودیو با ازاره MDF، پارچه دیواری و ویزور",
  },
];
---

<section style="
  background: #F5F0E6;
  padding: 80px 24px;
">
  <div style="max-width: 1100px; margin: 0 auto;">
    <!-- عنوان -->
    <div style="
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 32px;
    ">
      <div style="
        width: 8px;
        height: 48px;
        background: #B8763E;
        border-radius: 4px;
      "></div>
      <div>
        <p style="
          color: #B8763E;
          font-size: 13px;
          letter-spacing: 3px;
          margin: 0 0 4px;
        ">
          ACOUSTIC EXECUTION
        </p>
        <h2 style="
          color: #1B2A4A;
          font-size: 32px;
          margin: 0;
        ">
          اجرای آکوستیک
        </h2>
      </div>
    </div>

    <p style="
      color: #1C1C1C;
      font-size: 16px;
      line-height: 2;
      margin-bottom: 56px;
      max-width: 850px;
    ">
      اجرای آکوستیک استودیوها، نیازمند دقت بالایی در هماهنگی بین رشته‌ها بود. از نصب لوله‌های برق تا اجرای لایه‌های نهایی وول‌پنل، هر مرحله با کنترل کیفیت همراه بود. تصاویر زیر، مراحل کلیدی اجرا را نشان می‌دهند.
    </p>

    <!-- گالری -->
    <div style="
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    " class="gallery-grid">
      {gallery.map((item) => (
        <div style="
          background: #FFFFFF;
          border-radius: 12px;
          overflow: hidden;
        ">
          <div style="
            background: #1B2A4A;
            overflow: hidden;
            aspect-ratio: 4 / 3;
          ">
            <img
              src={item.image}
              alt={item.title}
              style="
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
              "
            />
          </div>

          <div style="padding: 20px;">
            <h3 style="
              color: #1B2A4A;
              font-size: 16px;
              margin-bottom: 8px;
              line-height: 1.5;
            ">
              {item.title}
            </h3>
            <p style="
              color: #4A5568;
              font-size: 13px;
              line-height: 1.7;
              margin: 0;
            ">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: repeat(2, 1fr) !important;
    }
  }

  @media (max-width: 550px) {
    .gallery-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>