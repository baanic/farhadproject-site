---
const disciplines = [
  {
    name: "ابنیه",
    count: "۴۷",
    unit: "قلم",
    color: "#8B6F47",
    percentage: 61,
    chapters: ["تخریب", "بتن", "کارهای فولادی", "آجرکاری", "عایق‌کاری", "کاشی", "سنگ", "رنگ‌آمیزی"],
  },
  {
    name: "مکانیک",
    count: "۱۵",
    unit: "قلم",
    color: "#5A4A7A",
    percentage: 19.5,
    chapters: ["لوله‌کشی", "کانال هوا", "دریچه", "عایق الاستومری", "بست و ساپورت"],
  },
  {
    name: "برق",
    count: "۱۵",
    unit: "قلم",
    color: "#2D5C8A",
    percentage: 19.5,
    chapters: ["سیم", "کابل", "لوله‌کشی", "تابلو", "اعلام حریق"],
  },
];

const highlights = [
  { value: "۸", label: "صورت‌وضعیت دوره‌ای", color: "#5C7A5C" },
  { value: "۳۰۰+", label: "صورت‌جلسه احجام", color: "#D89B5A" },
  { value: "۲۳", label: "خلاصه برآورد", color: "#2D5C8A" },
];
---

<section style="
  background: #F5F0E6;
  padding: 80px 24px;
">
  <div style="max-width: 1100px; margin: 0 auto;">
    <!-- عنوان -->
    <div style="
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 32px;
    ">
      <div style="
        width: 8px;
        height: 48px;
        background: #B8763E;
        border-radius: 4px;
      "></div>
      <div>
        <p style="
          color: #B8763E;
          font-size: 13px;
          letter-spacing: 3px;
          margin: 0 0 4px;
        ">
          QUANTITY SURVEYING
        </p>
        <h2 style="
          color: #1B2A4A;
          font-size: 32px;
          margin: 0;
        ">
          متره، برآورد و صورت‌وضعیت
        </h2>
      </div>
    </div>

    <!-- توضیح -->
    <p style="
      color: #1C1C1C;
      font-size: 16px;
      line-height: 2;
      margin-bottom: 56px;
      max-width: 850px;
    ">
      تهیه متره و برآورد کامل پروژه در سه رشته ابنیه، تأسیسات مکانیکی و تأسیسات برقی، بر اساس فهرست‌بهای واحد پایه انجام شد. در طول پروژه، ۸ صورت‌وضعیت دوره‌ای تهیه و به تأیید کارفرما رسید. کنترل احجام با تطبیق نقشه و اجرا، تهیه صورت‌جلسات احجام کاری، مدیریت تغییرات و تهیه اسناد پشتیبان، از جمله فعالیت‌های کلیدی این بخش بود.
    </p>

    <!-- کارت‌های متره به تفکیک رشته -->
    <div style="
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-bottom: 48px;
    " class="qs-grid">
      {disciplines.map((disc) => (
        <div style="
          background: #FFFFFF;
          border-radius: 12px;
          overflow: hidden;
        ">
          <!-- نوار رنگی -->
          <div style={`
            background: ${disc.color};
            color: #F5F0E6;
            padding: 24px;
          `}>
            <h3 style="
              font-size: 20px;
              margin: 0 0 8px;
            ">
              {disc.name}
            </h3>
            <div style="
              display: flex;
              align-items: baseline;
              gap: 8px;
            ">
              <span style="
                font-size: 32px;
                font-weight: 700;
                line-height: 1;
              ">
                {disc.count}
              </span>
              <span style="
                font-size: 14px;
                opacity: 0.85;
              ">
                {disc.unit}
              </span>
            </div>
          </div>

          <!-- محتوا -->
          <div style="padding: 20px 24px;">
            <!-- نوار درصد -->
            <div style="
              background: #F5F0E6;
              height: 6px;
              border-radius: 3px;
              overflow: hidden;
              margin-bottom: 12px;
            ">
              <div style={`
                width: ${disc.percentage}%;
                height: 100%;
                background: ${disc.color};
              `}></div>
            </div>
            <p style="
              color: #4A5568;
              font-size: 12px;
              margin: 0 0 16px;
              text-align: left;
            ">
              {disc.percentage}٪
            </p>

            <!-- فصل‌ها -->
            <div style="
              display: flex;
              flex-wrap: wrap;
              gap: 6px;
            ">
              {disc.chapters.map((chapter) => (
                <span style="
                  background: #F5F0E6;
                  color: #4A5568;
                  padding: 4px 10px;
                  border-radius: 12px;
                  font-size: 11px;
                ">
                  {chapter}
                </span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- کارت‌های شاخص -->
    <div style="
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    " class="highlights-grid">
      {highlights.map((item) => (
        <div style={`
          background: ${item.color};
          color: #F5F0E6;
          padding: 32px;
          border-radius: 12px;
          text-align: center;
        `}>
          <div style="
            font-size: 40px;
            font-weight: 700;
            line-height: 1;
            margin-bottom: 8px;
          ">
            {item.value}
          </div>
          <div style="
            font-size: 14px;
            opacity: 0.9;
          ">
            {item.label}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  @media (max-width: 768px) {
    .qs-grid,
    .highlights-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>