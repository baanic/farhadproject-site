---
import StatCard from "./StatCard.astro";

const { title, subtitle, stats } = Astro.props;
---

<section style="max-width: 1100px; margin: 0 auto; padding: 60px 24px 40px; direction: rtl;">
  <h1 style="color: #1B2A4A; font-size: 42px; margin-bottom: 12px; line-height: 1.3;">
    {title}
  </h1>
  <p style="color: #B8763E; font-size: 20px; margin-bottom: 48px;">
    {subtitle}
  </p>

  <h2 style="color: #1B2A4A; font-size: 24px; margin-bottom: 20px;">
    آمار کلیدی
  </h2>
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
    {stats.map((stat) => (
      <StatCard label={stat.label} value={stat.value} />
    ))}
  </div>
</section>