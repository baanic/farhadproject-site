---
import StatCard from "./StatCard.astro";

const { title, subtitle, stats } = Astro.props;
---

<section style="max-width: 900px; margin: 0 auto; padding: 40px 20px; direction: rtl;">
  <h1 style="color: #1B2A4A; font-size: 36px; margin-bottom: 8px;">
    {title}
  </h1>
  <p style="color: #B8763E; font-size: 18px; margin-bottom: 40px;">
    {subtitle}
  </p>

  <h2 style="color: #1B2A4A; font-size: 24px; margin-bottom: 16px;">
    آمار کلیدی
  </h2>
  <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px;">
    {stats.map((stat) => (
      <StatCard label={stat.label} value={stat.value} />
    ))}
  </div>
</section>