---
import masterData from "../../data/master_data.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";

// گرفتن همه پروژه‌ها
export async function getStaticPaths() {
  return masterData.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

// دریافت پروژه از props
const { project } = Astro.props;

// آمار پروژه
const stats = [
  { label: "زیربنا", value: `${project.area_m2.toLocaleString("fa-IR")} مترمربع` },
  { label: "مدت اجرا", value: `${project.total_duration_months} ماه` },
  { label: "مبلغ قرارداد", value: project.contract_amount_display_fa },
  { label: "وضعیت", value: project.status_fa },
];
---

<BaseLayout title={project.title_fa}>
  <Navbar />

  <main style="max-width: 1100px; margin: 0 auto; padding: 60px 24px;">
    <!-- لینک بازگشت -->
    <a href="/portfolio" style="
      color: #B8763E;
      font-size: 14px;
      display: inline-block;
      margin-bottom: 24px;
    ">
      ← بازگشت به پروژه‌ها
    </a>

    <!-- عنوان -->
    <h1 style="
      color: #1B2A4A;
      font-size: 42px;
      margin-bottom: 12px;
      line-height: 1.3;
    ">
      {project.title_fa}
    </h1>
    <p style="
      color: #B8763E;
      font-size: 20px;
      margin-bottom: 48px;
    ">
      {project.subtitle_fa}
    </p>

    <!-- آمار -->
    <h2 style="
      color: #1B2A4A;
      font-size: 24px;
      margin-bottom: 20px;
    ">
      آمار کلیدی
    </h2>
    <div style="
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin-bottom: 48px;
    ">
      {stats.map((stat) => (
        <div style="
          background: #F5F0E6;
          padding: 20px;
          border-radius: 8px;
        ">
          <div style="color: #4A5568; font-size: 14px; margin-bottom: 8px;">
            {stat.label}
          </div>
          <div style="color: #1B2A4A; font-size: 20px; font-weight: 700;">
            {stat.value}
          </div>
        </div>
      ))}
    </div>

    <!-- دامنه -->
    <h2 style="
      color: #1B2A4A;
      font-size: 24px;
      margin-bottom: 20px;
    ">
      دامنه خدمات
    </h2>
    <p style="
      color: #1C1C1C;
      font-size: 16px;
      line-height: 1.9;
      margin-bottom: 48px;
    ">
      {project.scope_fa}
    </p>

    <!-- نقش -->
    <h2 style="
      color: #1B2A4A;
      font-size: 24px;
      margin-bottom: 20px;
    ">
      نقش من
    </h2>
    <p style="
      color: #1C1C1C;
      font-size: 16px;
      line-height: 1.9;
    ">
      {project.role_fa}
    </p>
  </main>
</BaseLayout>