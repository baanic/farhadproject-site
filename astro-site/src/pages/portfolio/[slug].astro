---
import masterData from "../../data/master_data.json";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import PortfolioIntro from "../../components/portfolio/PortfolioIntro.astro";
import AboutMini from "../../components/portfolio/AboutMini.astro";
import ServicesMini from "../../components/portfolio/ServicesMini.astro";
import ProjectHero from "../../components/portfolio/ProjectHero.astro";
import Zoning from "../../components/portfolio/Zoning.astro";
import RoleTimeline from "../../components/portfolio/RoleTimeline.astro";
import TechnicalOfficeSection from "../../components/portfolio/TechnicalOfficeSection.astro";
import ProjectControlsSection from "../../components/portfolio/ProjectControlsSection.astro";
import QSSection from "../../components/portfolio/QSSection.astro";
import AcousticDesignSection from "../../components/portfolio/AcousticDesignSection.astro";
import AcousticExecutionSection from "../../components/portfolio/AcousticExecutionSection.astro";
import ResultsSection from "../../components/portfolio/ResultsSection.astro";
import DeliveriesSection from "../../components/portfolio/DeliveriesSection.astro";
import LessonsSection from "../../components/portfolio/LessonsSection.astro";
import ContactSection from "../../components/portfolio/ContactSection.astro";

export async function getStaticPaths() {
  return masterData.projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={project.title_fa} description={project.subtitle_fa}>
  <Navbar />

  <PortfolioIntro projectName={project.title_fa} year="۱۴۰۴" />

  <AboutMini />

  <ServicesMini />

  <ProjectHero project={project} />

  <Zoning />

  <RoleTimeline />

  <TechnicalOfficeSection />

  <ProjectControlsSection />

  <QSSection />

  <AcousticDesignSection />

  <AcousticExecutionSection />

  <ResultsSection />

  <DeliveriesSection />

  <LessonsSection />

  <ContactSection />
</BaseLayout>