---
import masterData from "../data/master_data.json";
import Hero from "../components/Hero.astro";

const project = masterData.projects[0];
const stats = [
  { label: "زیربنا", value: `${project.area_m2.toLocaleString("fa-IR")} مترمربع` },
  { label: "مدت اجرا", value: `${project.total_duration_months} ماه` },
  { label: "مبلغ قرارداد", value: project.contract_amount_display_fa },
  { label: "وضعیت", value: project.status_fa },
];
---

<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{project.title_fa}</title>
  </head>
  <body>
    <main style="font-family: Tahoma;">
      <Hero
        title={project.title_fa}
        subtitle={project.subtitle_fa}
        stats={stats}
      />
    </main>
  </body>
</html>