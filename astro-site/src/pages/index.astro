---
const title = "پرتفولیو فرهاد";
const subtitle = "دفتر فنی | کنترل پروژه | متره و برآورد | آکوستیک";
---

<!DOCTYPE html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
  </head>
  <body>
    <main style="font-family: Tahoma; text-align: center; padding: 60px 20px; direction: rtl;">
      <h1 style="color: #1B2A4A; font-size: 48px; margin-bottom: 16px;">
        {title}
      </h1>
      <p style="color: #B8763E; font-size: 20px;">
        {subtitle}
      </p>
    </main>
  </body>
</html>