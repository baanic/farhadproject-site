---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
---

<BaseLayout title="تماس">
  <Navbar />

  <main style="max-width: 700px; margin: 0 auto; padding: 60px 24px;">
    <h1 style="
      color: #1B2A4A;
      font-size: 42px;
      margin-bottom: 12px;
    ">
      تماس با من
    </h1>
    <p style="
      color: #4A5568;
      font-size: 18px;
      margin-bottom: 48px;
    ">
      اگر به دنبال یک متخصص دفتر فنی، کنترل پروژه، متره و برآورد یا آکوستیک هستید، با من تماس بگیرید.
    </p>

    <form
      id="contact-form"
      style="
        display: flex;
        flex-direction: column;
        gap: 20px;
      "
    >
      <!-- Access Key مخفی -->
      <input
        type="hidden"
        name="access_key"
        value="6caa2416-c804-47ab-af2b-aa547f25bc85"
      />

      <!-- جلوگیری از اسپم -->
      <input
        type="checkbox"
        name="botcheck"
        style="display: none;"
      />

      <!-- نام -->
      <div>
        <label for="name" style="
          display: block;
          color: #1B2A4A;
          font-size: 14px;
          font-weight: 500;
          margin-bottom: 8px;
        ">
          نام و نام خانوادگی
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          style="
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #D9D4C8;
            border-radius: 8px;
            font-family: inherit;
            font-size: 15px;
            background: #FFFFFF;
          "
        />
      </div>

      <!-- ایمیل -->
      <div>
        <label for="email" style="
          display: block;
          color: #1B2A4A;
          font-size: 14px;
          font-weight: 500;
          margin-bottom: 8px;
        ">
          ایمیل
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          style="
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #D9D4C8;
            border-radius: 8px;
            font-family: inherit;
            font-size: 15px;
            background: #FFFFFF;
          "
        />
      </div>

      <!-- موضوع -->
      <div>
        <label for="subject" style="
          display: block;
          color: #1B2A4A;
          font-size: 14px;
          font-weight: 500;
          margin-bottom: 8px;
        ">
          موضوع
        </label>
        <input
          type="text"
          id="subject"
          name="subject"
          required
          style="
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #D9D4C8;
            border-radius: 8px;
            font-family: inherit;
            font-size: 15px;
            background: #FFFFFF;
          "
        />
      </div>

      <!-- پیام -->
      <div>
        <label for="message" style="
          display: block;
          color: #1B2A4A;
          font-size: 14px;
          font-weight: 500;
          margin-bottom: 8px;
        ">
          پیام
        </label>
        <textarea
          id="message"
          name="message"
          rows="6"
          required
          style="
            width: 100%;
            padding: 12px 16px;
            border: 1px solid #D9D4C8;
            border-radius: 8px;
            font-family: inherit;
            font-size: 15px;
            background: #FFFFFF;
            resize: vertical;
          "></textarea>
      </div>

      <!-- دکمه ارسال -->
      <button
        type="submit"
        id="submit-button"
        style="
          background: #1B2A4A;
          color: #F5F0E6;
          padding: 14px 32px;
          border: none;
          border-radius: 8px;
          font-family: inherit;
          font-size: 16px;
          font-weight: 500;
          cursor: pointer;
          transition: all 0.2s;
        "
      >
        ارسال پیام
      </button>

      <!-- پیغام وضعیت -->
      <p
        id="form-status"
        style="
          font-size: 14px;
          text-align: center;
          margin-top: 8px;
          min-height: 20px;
        "
      ></p>
    </form>

    <script is:inline>
      const form = document.getElementById("contact-form");
      const status = document.getElementById("form-status");
      const submitButton = document.getElementById("submit-button");

      form.addEventListener("submit", async function (e) {
        e.preventDefault();

        // غیرفعال کردن دکمه
        submitButton.disabled = true;
        submitButton.textContent = "در حال ارسال...";
        submitButton.style.opacity = "0.6";
        status.textContent = "";

        const formData = new FormData(form);

        try {
          const response = await fetch(
            "https://api.web3forms.com/submit",
            {
              method: "POST",
              body: formData,
            }
          );

          const data = await response.json();

          if (data.success) {
            status.style.color = "#5C7A5C";
            status.textContent =
              "✓ پیام شما با موفقیت ارسال شد. به‌زودی پاسخ خواهم داد.";
            form.reset();
          } else {
            status.style.color = "#A33";
            status.textContent =
              "✗ خطا در ارسال پیام. لطفاً دوباره تلاش کنید.";
          }
        } catch (error) {
          status.style.color = "#A33";
          status.textContent = "✗ خطا در ارتباط با سرور. لطفاً دوباره تلاش کنید.";
        } finally {
          submitButton.disabled = false;
          submitButton.textContent = "ارسال پیام";
          submitButton.style.opacity = "1";
        }
      });
    </script>
  </main>
</BaseLayout>